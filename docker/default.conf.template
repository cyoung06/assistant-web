# The app, on the tailnet.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    # Behind TLS on the tailnet: a redirect names a path only, never this listener's http://…:8080.
    absolute_redirect off;

    # API, same origin as the app.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 16m;
    }

    # Notes edited live: a WebSocket (y-websocket), held open as long as the note is.
    location = /api/v1/sync {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # The drive's own endpoint (/api/v1/drive, no slash): passed on, not answered with nginx's
    # add-a-slash redirect (which /api/v1/drive/ below would give it).
    location = /api/v1/drive {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Drive files: any size, streamed both ways (uploads aren't spooled here first, videos play as they arrive).
    location /api/v1/drive/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
    }

    # Hashed build assets never change.
    # Compressed on the way (the notes' core and its fonts are most of their size; the fonts, with no
    # type of their own here, go as octet-stream).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        gzip on;
        gzip_types application/javascript text/css image/svg+xml application/wasm application/octet-stream;
        # The PDF viewer's worker is a module (.mjs), which browsers only run as JavaScript.
        include /etc/nginx/mime.types;
        types { application/javascript mjs; }
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

# The internet's way in (the public ingress): the Outlook add-in and its API, nothing else.
server {
    listen 8081;
    server_name _;
    root /usr/share/nginx/html;
    # Behind the public ingress's TLS: a redirect names a path only, never this listener's http://…:8081.
    absolute_redirect off;

    location /outlook/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/v1/public/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Marks the request as from the internet, replacing whatever the client sent: the API serves
        # such requests nothing but the public API.
        proxy_set_header X-Assistant-Entry public;
        client_max_body_size 1m;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
